{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "allowJs": false,
        "resolveJsonModule": true,
        "allowImportingTsExtensions": true,
        "types": ["node"]
    },
    "include": ["src/**/*", "tests/**/*", "vitest.config.ts"]
}
